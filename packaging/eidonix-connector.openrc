#!/sbin/openrc-run
# OpenRC service for Alpine and other non-systemd hosts. Where the connector
# may connect is enforced in the process from the configuration file
# (upstream, proxy and each service's address), the same as under systemd.

name="eidonix-connector"
description="Eidonix connector"
command="/usr/bin/eidonix-connector"
command_args="run --config /etc/eidonix-connector/connector.yaml"
command_user="eidonix-connector:eidonix-connector"
supervisor="supervise-daemon"
respawn_delay=5
# A stop drains: the connector finishes running requests (its --drain-timeout
# is 10 minutes) before exiting. Wait 11 minutes before KILL.
retry="TERM/660/KILL/5"
respawn_max=0
umask=0077
required_files="/etc/eidonix-connector/connector.yaml"
output_logger="logger -t eidonix-connector -p daemon.info"
error_logger="logger -t eidonix-connector -p daemon.err"
extra_commands="checkconfig"
extra_started_commands="reload reopen"
description_checkconfig="Check the configuration and explain what it shares"
description_reload="Reload the configuration without dropping running requests"
description_reopen="Reopen the access log after rotation"

start_pre() {
	# Where "eidonix-connector status" reads the running connector's status.
	checkpath --directory --owner eidonix-connector:eidonix-connector --mode 0750 /run/eidonix-connector
}

depend() {
	need net
	use dns
	after firewall
}

checkconfig() {
	ebegin "Checking $name configuration"
	su -s /bin/sh eidonix-connector -c "$command check --config /etc/eidonix-connector/connector.yaml" >/dev/null
	eend $?
}

reload() {
	ebegin "Reloading $name"
	supervise-daemon "$RC_SVCNAME" --signal HUP
	eend $?
}

reopen() {
	ebegin "Reopening $name access log"
	supervise-daemon "$RC_SVCNAME" --signal USR1
	eend $?
}
