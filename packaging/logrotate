/var/log/cletus-connector/audit.jsonl {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 cletus-connector cletus-connector
    sharedscripts
    postrotate
        if command -v systemctl >/dev/null 2>&1; then
            systemctl kill --kill-who=main --signal=USR1 cletus-connector.service
        else
            rc-service --ifstarted cletus-connector reopen
        fi >/dev/null 2>&1 || true
    endscript
}
