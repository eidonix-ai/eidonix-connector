[Unit]
Description=Eidonix connector
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/eidonix-connector/config.toml

[Service]
User=eidonix-connector
Group=eidonix-connector
ExecStart=/usr/bin/eidonix-connector run --config /etc/eidonix-connector/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @module @raw-io @reboot @swap @debug @cpu-emulation @obsolete
ReadWritePaths=/var/log/eidonix-connector
UMask=0077
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
