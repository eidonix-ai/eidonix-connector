[Unit]
Description=Eidonix connector
Documentation=https://github.com/eidonix-ai/eidonix-connector
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/eidonix-connector/connector.yaml

[Service]
User=eidonix-connector
Group=eidonix-connector
ExecStart=/usr/bin/eidonix-connector run --config /etc/eidonix-connector/connector.yaml
ExecReload=/bin/kill -HUP $MAINPID
# A stop (and so an upgrade's restart) drains: the connector finishes the
# requests running (up to its own 10 minute --drain-timeout) before exiting.
# Leave systemd room beyond that before it sends SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=11min
Restart=always
RestartSec=5
# /run/eidonix-connector/status.json, read by "eidonix-connector status".
RuntimeDirectory=eidonix-connector
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @module @raw-io @reboot @swap @debug @cpu-emulation @obsolete
ReadWritePaths=/var/log/eidonix-connector
UMask=0077
# Where the connector may connect is enforced in the process from the
# configuration file (upstream, proxy and each service's address); there is
# no separate network policy file to keep in step.

[Install]
WantedBy=multi-user.target
